# Parámetros para una base Neon NUEVA e independiente.
# Combinar con el .env privado completo de Laravel.
# Pendiente de crear el proyecto y obtener la conexión real.
DB_CONNECTION=pgsql
DB_HOST=REPLACE_NEON_POOLED_HOST
DB_PORT=5432
DB_DATABASE=teralinde_crm
DB_USERNAME=teralinde_crm_app
DB_PASSWORD=
DB_SCHEMA=teralinde_crm
DB_SSLMODE=require
